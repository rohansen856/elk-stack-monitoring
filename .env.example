# =============================================================================
# Sentinel - environment configuration
#
# Copy to .env and fill in real values:  cp .env.example .env
#
# Every variable without a default is REQUIRED: app/config.py instantiates
# Settings at import time, so a missing one is a hard startup failure, not a
# warning. Generate secrets with:  openssl rand -hex 32
# =============================================================================

# --- Database (required) -----------------------------------------------------
POSTGRES_DB=todo_db
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=CHANGE_ME_generate_a_strong_password
DATABASE_URL=postgresql://sentinel:CHANGE_ME_generate_a_strong_password@db:5432/todo_db

# --- Redis (required) --------------------------------------------------------
# Redis is password-protected; the password must appear in both variables.
REDIS_PASSWORD=CHANGE_ME_generate_a_strong_password
REDIS_URL=redis://:CHANGE_ME_generate_a_strong_password@redis:6379/0

# --- JWT (required) ----------------------------------------------------------
# openssl rand -hex 32
SECRET_KEY=CHANGE_ME_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Application -------------------------------------------------------------
# ENVIRONMENT=production disables /docs and /redoc and hard-disables the
# /api/v1/security/simulate/* endpoints.
ENVIRONMENT=development
LOG_LEVEL=INFO
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# --- Password reset OTP ------------------------------------------------------
OTP_LENGTH=8
OTP_EXPIRE_MINUTES=15
OTP_MAX_ATTEMPTS=5

# --- Elasticsearch / ELK (required for threat detection) ---------------------
# ELASTICSEARCH_PASSWORD is the variable the application actually reads. There
# is deliberately no default: an unauthenticated client against a secured
# cluster is what previously made threat detection silently inoperative.
ELASTIC_PASSWORD=CHANGE_ME_generate_a_strong_password
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=CHANGE_ME_generate_a_strong_password
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_USE_SSL=false
KIBANA_SYSTEM_PASSWORD=CHANGE_ME_generate_a_strong_password
KIBANA_HOST=kibana
KIBANA_PORT=5601
LOGSTASH_HOST=logstash
LOGSTASH_PORT=5044
LOGSTASH_TCP_PORT=5000

# --- Observability -----------------------------------------------------------
# /metrics requires a bearer token (this value) or a valid user JWT.
METRICS_TOKEN=CHANGE_ME_openssl_rand_hex_32

# --- Alerting (optional) -----------------------------------------------------
# When unset, Slack alerting is disabled and says so at startup rather than
# silently posting to a placeholder URL.
SLACK_WEBHOOK_URL=
ALERT_EMAIL_TO=

# --- Email / SMTP (required - used for password reset) -----------------------
# NOTE: these are the exact names app/config.py reads. Older documentation
# referred to SMTP_SERVER / EMAIL_USER / EMAIL_PASSWORD, which do not exist and
# would cause a startup failure.
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=your-email@example.com
EMAIL_SMTP_PASSWORD=CHANGE_ME_smtp_app_password
EMAIL_SENDER_ADDRESS=your-email@example.com
EMAIL_SENDER_NAME=Sentinel Security Monitoring

# --- Threat intelligence (optional) ------------------------------------------
ALIENVAULT_OTX_API_KEY=
