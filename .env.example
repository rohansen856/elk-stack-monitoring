# =============================================================================
# Sentinel - environment configuration
#
#   cp .env.example .env
#   cp website/.env.example website/.env
#   docker compose up -d
#
# The values below are REAL, randomly generated, and work out of the box for a
# local stack. They are committed deliberately so the quick start works.
#
#   >> THEY ARE DEVELOPMENT CREDENTIALS. Regenerate every one of them before
#   >> exposing this stack to anything. Generate with:
#   >>     openssl rand -hex 32      (keys)
#   >>     openssl rand -base64 24   (passwords)
#
# There are no fallback defaults in the code or compose file: if a value is
# missing the stack refuses to start rather than silently using a known
# password. See AUDIT/FINDINGS.md SEC-004.
# =============================================================================

# --- Database ----------------------------------------------------------------
POSTGRES_DB=todo_db
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=qtpxgWRD90ljuOHcmgFHGYyN
DATABASE_URL=postgresql://sentinel:qtpxgWRD90ljuOHcmgFHGYyN@db:5432/todo_db

# --- Redis -------------------------------------------------------------------
# The password appears twice: once for the server, once in the client URL.
REDIS_PASSWORD=bBLsQjXmxwTlGoE1HTaWDeNv
REDIS_URL=redis://:bBLsQjXmxwTlGoE1HTaWDeNv@redis:6379/0

# --- JWT ---------------------------------------------------------------------
SECRET_KEY=c73491b60ea8769e0b00fe017bd34183d15ecd1f2bd48d8bb9d79b15d6d387c5
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Network exposure --------------------------------------------------------
# Interface nginx publishes on. Loopback by default so a local stack is not
# reachable from the LAN. Set to 0.0.0.0 to expose it deliberately.
NGINX_BIND=127.0.0.1

# --- Application -------------------------------------------------------------
# ENVIRONMENT=production disables /docs and /redoc and hard-disables the
# /api/v1/security/simulate/* endpoints.
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost,https://localhost,http://localhost:3000

# --- Password reset OTP ------------------------------------------------------
OTP_LENGTH=8
OTP_EXPIRE_MINUTES=15
OTP_MAX_ATTEMPTS=5

# --- Elasticsearch -----------------------------------------------------------
# ELASTIC_PASSWORD is the cluster superuser password used by the beats,
# Logstash and the bootstrap job. ELASTICSEARCH_PASSWORD is the same value read
# by the application; both are listed so neither silently falls back.
ELASTIC_PASSWORD=dK2fwcD2unlU5oTsOFQXlSAP
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=dK2fwcD2unlU5oTsOFQXlSAP
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_USE_SSL=false

# --- Kibana ------------------------------------------------------------------
KIBANA_SYSTEM_PASSWORD=NwJ8WQedE5i6chNyH8etIIF0
KIBANA_HOST=kibana
KIBANA_PORT=5601
# 32-byte hex. Kibana refuses to start if these are shorter than 32 characters.
KIBANA_ENCRYPTION_KEY=f5600f0f43d171f34b361a92836ac331
KIBANA_REPORTING_KEY=ff054ed9d40412eddb3ccd60615abb1e
KIBANA_SAVEDOBJECTS_KEY=f6da6e4248e285401e1cc594c1eb6720

# --- Logstash ----------------------------------------------------------------
LOGSTASH_HOST=logstash
LOGSTASH_PORT=5044
LOGSTASH_TCP_PORT=5000

# --- Observability -----------------------------------------------------------
# /metrics accepts this as a bearer token, or any valid user JWT.
METRICS_TOKEN=3f956ed6fd67985e7480d7e5a118341dee4d3534f74b2d83

# --- Alerting (optional) -----------------------------------------------------
# Leave empty to disable. The service logs a warning once rather than silently
# posting to a placeholder URL.
SLACK_WEBHOOK_URL=
ALERT_EMAIL_TO=

# --- Email / SMTP ------------------------------------------------------------
# Required: the application will not start without them. The placeholder host
# below lets the stack boot; password-reset delivery will fail and be logged
# until you point this at a real SMTP server.
EMAIL_SMTP_SERVER=smtp.example.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=sentinel@example.com
EMAIL_SMTP_PASSWORD=replace-with-a-real-smtp-app-password
EMAIL_SENDER_ADDRESS=sentinel@example.com
EMAIL_SENDER_NAME=Sentinel Security Monitoring

# --- Threat intelligence (optional) ------------------------------------------
ALIENVAULT_OTX_API_KEY=
