# Backend API base URL, used ONLY by Next.js server-side route handlers.
#
# Points straight at the backend container over the internal Docker network
# rather than looping back through nginx: nginx now redirects HTTP to HTTPS and
# serves a self-signed certificate, which server-side fetch rejects
# (DEPTH_ZERO_SELF_SIGNED_CERT). Going direct is also one less hop.
#
# This value is never exposed to the browser.
BACKEND_URL=http://app:8000/api/v1

# Public base URL of the application as a browser sees it.
NEXT_PUBLIC_APP_URL=https://localhost/frontend
